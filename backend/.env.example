# Plantilla de variables de entorno. Copiala a `.env` y completá los valores.
# NUNCA se commitea un `.env` con valores reales — ni siquiera de ejemplo:
# `.env` está en .gitignore y los secretos de verdad viven en AWS Secrets
# Manager (ver Fase 6).

# --- Base de datos -----------------------------------------------------------
# Local:   postgres://<usuario>@localhost:5432/enactus_dev
# Staging: la segunda base de la misma instancia RDS (enactus_staging)
# Prod:    la base principal de RDS (enactus)
DATABASE_URL=

# --- Autenticación -----------------------------------------------------------
# Secreto de firma del JWT. Generalo con:  openssl rand -base64 48
# En AWS vive en Secrets Manager, no acá.
JWT_SECRET=
# Vigencia del access token. 12 h para igualar el AuthProvider actual de Flutter.
ACCESS_TOKEN_TTL=12h
# Vigencia del refresh token (con rotación en cada uso).
REFRESH_TOKEN_TTL=30d

# --- Almacenamiento ----------------------------------------------------------
AWS_REGION=us-east-1
S3_BUCKET=
# Los videos propios se sirven SIEMPRE por CloudFront, nunca por URL directa
# de S3 (1 TB/mes gratis vs. 100 GB) — ver README, sección "Manejo de video".
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
# Clave privada de CloudFront para firmar URLs (PEM). En AWS, Secrets Manager.
CLOUDFRONT_PRIVATE_KEY=

# --- API ---------------------------------------------------------------------
# Origen exacto del frontend, para CORS. Sin comodines en producción.
CORS_ORIGIN=http://localhost:8080
PORT=3000
NODE_ENV=development
