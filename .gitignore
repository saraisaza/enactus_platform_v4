# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Obsidian vault / Claude Code plugin config (local knowledge base, not app code)
/Enactus V3/
/.claude/

# Backup of the unpatched licensed Knockout font file (not for distribution)
/font_backups/

# graphify knowledge-graph cache (generated, regenerate with `graphify update .`)
/graphify-out/

# Variables locales de desarrollo (antes esta línea era un comando de terminal
# pegado por error y no ignoraba nada).
.dev.vars

# Identidades reales de los super admins para seed:prod. Nunca al repo.
admins.json
backend/admins.json

# Artefactos de empaquetado de la Lambda de administración: node_modules
# copiado y el zip. El código fuente (index.mjs, rds-ca.pem) sí se versiona.
backend/infra/lambda-admin/node_modules/
backend/infra/lambda-admin/*.zip
backend/dist-lambda/
backend/dist-tareas/
backend/infra/*.zip

# Firma y credenciales de las apps móviles: nunca al repositorio.
# La llave de subida de Android y su contraseña (android/key.properties), los
# certificados y perfiles de Apple y las llaves de App Store Connect viven solo
# en la máquina que compila y en el gestor de contraseñas.
*.jks
*.keystore
key.properties
*.p12
*.p8
*.cer
*.mobileprovision
*.provisionprofile
.env
.env.*
!.env.example

# Capturas de pantalla para comparar el aspecto antes y después de un cambio
# (test/capturas/capturas_test.dart). Dependen de la máquina que las genera.
test/capturas/goldens/
test/capturas/failures/
