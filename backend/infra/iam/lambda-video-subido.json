{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SubirYBorrarVideosDeLecciones",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::enactus-media-dev/lessons/*"
    },
    {
      "Sid": "UnaKeyQueNoExisteEs404",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::enactus-media-dev",
      "Condition": {
        "StringLike": { "s3:prefix": "lessons/*" }
      }
    }
  ]
}
