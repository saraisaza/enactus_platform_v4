# Plantilla de variables de entorno. Copiala a `.env` y completá los valores.
# NUNCA se commitea un `.env` con valores reales — ni siquiera de ejemplo:
# `.env` está en .gitignore y los secretos de verdad viven en AWS Secrets
# Manager (ver Fase 6).

# --- Base de datos -----------------------------------------------------------
# Local:   postgres://<usuario>@localhost:5432/enactus_dev
# Staging: la segunda base de la misma instancia RDS (enactus_staging)
# Prod:    la base principal de RDS (enactus)
DATABASE_URL=

# --- Autenticación -----------------------------------------------------------
# Secreto de firma del JWT. Generalo con:  openssl rand -base64 48
# En AWS vive en Secrets Manager, no acá.
JWT_SECRET=
# Vigencia del access token. 12 h para igualar el AuthProvider actual de Flutter.
ACCESS_TOKEN_TTL=12h
# Vigencia del refresh token (con rotación en cada uso).
REFRESH_TOKEN_TTL=30d

# --- Almacenamiento ----------------------------------------------------------
AWS_REGION=us-east-1
S3_BUCKET=
# ACÁ NO VAN CREDENCIALES DE AWS, y la ausencia es deliberada.
#
# Un campo `AWS_ACCESS_KEY_ID=` vacío en un archivo de ejemplo invita a
# rellenarlo por costumbre — y de ahí a que una llave termine en un
# repositorio hay un `git add` de distancia.
#
# En local, el SDK toma las credenciales de `~/.aws/credentials` por la cadena
# por defecto. Basta con decirle qué perfil usar:
#
#     AWS_PROFILE=enactus-dev npm run dev
#
# Sin eso, firmar una URL de S3 responde `503 storage_unavailable`. No es un
# fallo del código: es que no hay con qué firmar.
#
# En AWS no las pone nadie: el runtime de Lambda inyecta AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY y AWS_SESSION_TOKEN en cada invocación, derivadas del
# rol de ejecución y rotadas solas. Existen, pero no se configuran — Lambda
# reserva esos nombres y rechaza el deploy si se declaran a mano.
# Los videos propios se sirven SIEMPRE por CloudFront, nunca por URL directa
# de S3 (1 TB/mes gratis vs. 100 GB) — ver README, sección "Manejo de video".
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
# Clave privada de CloudFront para firmar URLs (PEM). En AWS, Secrets Manager.
CLOUDFRONT_PRIVATE_KEY=

# --- API ---------------------------------------------------------------------
# Origen exacto del frontend, para CORS. Sin comodines en producción.
CORS_ORIGIN=http://localhost:8080
PORT=3000
NODE_ENV=development

# Cuántos proxies de confianza hay DELANTE de la aplicación.
#
# De este número sale la IP del cliente, y de esa IP dependen los dos límites
# de peticiones. Ponerlo mal no rompe nada visible: el límite deja de frenar,
# en silencio.
#
#   0  (default)  sin proxy: se ignora x-forwarded-for y se usa la conexión.
#                 Es el único valor seguro cuando no se sabe.
#   2             CloudFront -> API Gateway -> Lambda.
#
# Ver "Cómo se cuenta la IP del cliente" en RUNBOOK.md, que incluye cómo
# comprobarlo contra el despliegue real en vez de suponerlo.
TRUSTED_PROXY_HOPS=0
