{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ObjetosDelBucket",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::enactus-media-dev/*"
    },
    {
      "Sid": "ListarElBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": "arn:aws:s3:::enactus-media-dev"
    }
  ]
}
